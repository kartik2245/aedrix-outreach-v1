# Anthropic Claude API Configuration
# Leave blank to run in zero-cost offline template/dry-run mode
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Deepline Dynamic Discovery API Configuration
DEEPLINE_API_KEY=
DEEPLINE_BASE_URL=https://api.deepline.ai/v1
DEEPLINE_LIVE=false
DEEPLINE_RUN_CONFIRMATION=false

# Smartlead Production API Configuration
SMARTLEAD_API_KEY=
SMARTLEAD_BASE_URL=https://server.smartlead.ai/api/v1
SMARTLEAD_LIVE=false
SMARTLEAD_CAMPAIGN_ID=

# Primary Production Database (Supabase PostgreSQL)
DATABASE_ENABLED=true
DATABASE_URL=postgresql+psycopg://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:5432/postgres

# Batch Execution Settings
BATCH_SIZE=400
CLAUDE_BATCH_SIZE=25

# Safety Controls - DO NOT CHANGE IN TESTING/POC
DRY_RUN=true
SEND_EMAILS=false
PRODUCTION_SEND_CONFIRMATION=false
